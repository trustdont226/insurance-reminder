# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata
DEBUG=false

# ─── Supabase (required only after migration from SQLite) ──────────────────
# Postgres connection string from Supabase → Settings → Database → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Supabase project URL and anon/public key — Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage bucket name
SUPABASE_BUCKET=pdfs

# ─── Local development overrides (optional) ────────────────────────────────
# DB_PATH=./insurance_records.db
# UPLOAD_FOLDER=./uploads
